{
  "name": "hi-introvert",
  "version": "1.2.7",
  "description": "A quiet corner of the internet where silence is understood.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hi-introvert": "./bin/hi-introvert.js"
  },
  "files": [
    "dist",
    "bin",
    "entities",
    "src",
    "README.md",
    "README.npm.md"
  ],
  "readme": "README.npm.md",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target node --format esm --external @v1b3x0r/mds-core --external ink-big-text --external cfonts --define process.env.DEV=\"'false'\"",
    "test": "bun test",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@v1b3x0r/mds-core": "^5.11.1",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "cli",
    "chat",
    "introvert",
    "p2p",
    "cognition",
    "mds",
    "terminal",
    "minimal",
    "ai",
    "companion",
    "emergent",
    "linguistics"
  ],
  "author": "v1b3x0r",
  "license": "MIT",
  "homepage": "https://github.com/v1b3x0r/mds#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v1b3x0r/mds.git",
    "directory": "hi-introvert"
  },
  "bugs": {
    "url": "https://github.com/v1b3x0r/mds/issues"
  },
  "engines": {
    "node": ">=18"
